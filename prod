#!/bin/bash
# Builda e sobe os serviços em produção via PM2
set -e

APP_DIR="/root/projetos/teamuniz"

echo "🔨 Buildando frontend (webapp)..."
cd "$APP_DIR/frontbot/webapp"
npm run build

echo ""
echo "🔨 Buildando backend..."
cd "$APP_DIR/backend"
npm run build

echo ""
echo "🚀 Subindo serviços em produção..."
# Recria os processos para garantir que o config atualizado seja aplicado
pm2 delete teamuniz-frontend teamuniz-backend teamuniz-bot 2>/dev/null || true
pm2 start "$APP_DIR/ecosystem.config.js"

echo ""
echo "💾 Salvando lista PM2..."
pm2 save

echo ""
pm2 list
echo ""
echo "✅ Produção no ar! https://teamuniz.asynccode.com.br"
